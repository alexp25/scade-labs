                (#12 wire #8 => #6 .(speed))
                (#11 wire #9 => #6 .(set_point))
                (#10 wire #6 => #7
                #pragma diagram {"wp":"v0|#6 #7"} #end)
            state #17 cc_standby
            #pragma diagram {"xy":"h57594;v-1850","wh":"36825;12000"} #end :
              diagram
                (#14 def throttle
                #pragma diagram {"xy":"h8412;v0","wh":"12000;3200"} #end)
                (#15 expr accel
                #pragma diagram {"xy":"h-9412;v0","wh":"10000;3200"} #end)
                
                (#16 wire #15 => #14)
            :1: #13 until if (brake > 10.0 or accel > 10.0)
            restart #17
            #pragma diagram {"tp":"h39978;v-1850|#13 h11744 h11744 h-18412;v0|#17"} #end;
            :1: #17 until if (res and brake<10.0)
            restart #13
