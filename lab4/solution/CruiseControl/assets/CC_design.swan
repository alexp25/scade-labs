      :1: #4 until if (on)
      restart #18
      #pragma diagram {"tp":"h20650;v0|#4 h5817 h5817 h-84007;v-8550|#18"} #end;
    #pragma diagram {"xy":"H12482;V7700","wh":"234764;59100"} #end)
