          (#3 wire #2 => #1)
      state #18 cc_enabled
      #pragma diagram {"xy":"h29375;v0","wh":"168014;51100"} #end :
        diagram
          (automaton #5
            initial state #13 cc_active
            #pragma diagram {"xy":"h-36029;v0","wh":"79956;35100"} #end :
              diagram
                (#6 block regulator
                #pragma diagram {"xy":"h-2291;v-2850","wh":"20000;14000"} #end)
                (#7 def throttle
