node manual_control (accel : float32;)
  returns (throttle: float32;)
{
  diagram
    (#0 def throttle
    #pragma diagram {"xy":"H-24750;V-5950","wh":"12000;3200"} #end)
    (#1 expr accel
    #pragma diagram {"xy":"H-44750;V-5950","wh":"10000;3200"} #end)
    
    (#2 wire #1 => #0)
}

node main_manual (brake : float32;
                  accel : float32;)
  returns (rpm_out: float32;
           speed : float32;
           gear_out : int32;)
{
  diagram
    (#0 block car
    #pragma diagram {"xy":"H-27598;V-5307","wh":"20000;14000"} #end)
    (#1 def speed
    #pragma diagram {"xy":"H5219;V-6128","wh":"10000;3200"} #end)
    (#2 expr brake
    #pragma diagram {"xy":"H-60416;V92","wh":"10000;3200"} #end)
    (#3 def rpm_out
    #pragma diagram {"xy":"H6219;V-10707","wh":"12000;3200"} #end)
    (#4 def gear_out
    #pragma diagram {"xy":"H6219;V-1549","wh":"12000;3200"} #end)
    (#6 expr #11 * #12
      where
        (#11 group)
        (#12 group)
    #pragma diagram {"xy":"H-60416;V-8967"} #end)
    (#5 expr accel
    #pragma diagram {"xy":"H-80379;V-10867","wh":"10000;3200"} #end)
    (#13 expr 100.0
    #pragma diagram {"xy":"H-80379;V-7067","wh":"10000;3200"} #end)
    
    (#14 wire #6 => #0 .(throttle_percent))
    (#7 wire #0 .(gear) => #4
    #pragma diagram {"wp":"v3758|#0 #4"} #end)
    (#8 wire #0 .(rpm) => #3
    #pragma diagram {"wp":"v-5400|#0 #3"} #end)
    (#9 wire #2 => #0 .(brake))
    (#10 wire #0 .(speed) => #1
    #pragma diagram {"wp":"v-821|#0 #1"} #end)
    (#15 wire #5 => #11)
    (#16 wire #13 => #12)
}
