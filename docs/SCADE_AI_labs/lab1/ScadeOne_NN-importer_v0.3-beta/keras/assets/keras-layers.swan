use keras::utils;

use keras::activations;

function ReLU <<N>> (x: 'T^N;
                     has_max : bool default=false;
                     max_value: 'T default = 0;
                     threshold: 'T default = 0;
                     negative_slope: 'T default = 0;)
  returns (y: 'T^N;)
  where 'T numeric
{
  diagram
    (/* ReLU (Rectified Linear Unit) activation layer with:
       * input_shape=(N,), 
       * max_value=None by default,
       * negative_slope=0 by default
       * threshold=0 by default
     */ let
    #pragma diagram {"xy":"H-72523;V-68421","wh":"54630;13516"} #end)
    
    (activate #6 $ActivateIfRelu
      if has_max
      then
        {
          diagram
            (#7 def y
            #pragma diagram {"xy":"h42688;v0"} #end)
            (#8 expr max_value ^ N
            #pragma diagram {"xy":"h-33906;v7100","wh":"16189;3200"} #end)
            (#9 expr threshold ^ N
            #pragma diagram {"xy":"h-33906;v-3125","wh":"16189;3200"} #end)
            (#10 expr negative_slope ^ N
            #pragma diagram {"xy":"h-36250;v1987","wh":"20877;3200"} #end)
            (#11 expr x
            #pragma diagram {"xy":"h-29812;v-6625"} #end)
            (#12 block (map activations::relu_max) <<N>>
            #pragma diagram {"xy":"h12288;v0","wh":"25000;22700"} #end)
            
            (#14 wire #8 => #12 .(max_value))
            (#15 wire #10 => #12 .(negative_slope))
            (#16 wire #9 => #12 .(threshold))
            (#17 wire #11 => #12 .(x))
            (#18 wire #12 .(y) => #7
            #pragma diagram {"wp":"v-2000|#12 #7"} #end)
        #pragma diagram {"xy":"h0;v-27562","wh":"102377;28700"} #end
        }
      elsif (threshold <> 0) or (negative_slope <> 0)
      then
        {
          diagram
            (#19 expr negative_slope ^ N
            #pragma diagram {"xy":"h-36250;v5193","wh":"20877;3200"} #end)
            (#20 def y
            #pragma diagram {"xy":"h42688;v0"} #end)
            (#21 block (map activations::relu_no_max) <<N>>
            #pragma diagram {"xy":"h12288;v0","wh":"25000;19950"} #end)
            (#23 expr x
            #pragma diagram {"xy":"h-29812;v-3500"} #end)
            (#24 expr threshold ^ N
            #pragma diagram {"xy":"h-33906;v0","wh":"16189;3200"} #end)
            
            (#25 wire #23 => #21 .(x))
            (#26 wire #24 => #21 .(threshold))
            (#27 wire #21 .(y) => #20
            #pragma diagram {"wp":"v-2000|#21 #20"} #end)
            (#28 wire #19 => #21 .(negative_slope))
        #pragma diagram {"xy":"h0;v3963","wh":"102377;25950"} #end
        }
      else
        {
          diagram
            (#2 block (map activations::relu) <<N>>
            #pragma diagram {"xy":"h12688;v0","wh":"25000;18000"} #end)
            (#1 expr x
            #pragma diagram {"xy":"h-30000;v0"} #end)
            (#0 def y
            #pragma diagram {"xy":"h42688;v-12"} #end)
            
            (#4 wire #1 => #2)
            (#5 wire #2 => #0
            #pragma diagram {"wp":"v-2012|#2 #0"} #end)
        #pragma diagram {"xy":"h0;v33125","wh":"102377;23975"} #end
        }
    #pragma diagram {"xy":"H-74744;V-9675","wh":"102377;93225"} #end)
}

function Dense <<N, M>> (x: 'T ^N;
                         kernel : 'T ^M ^N;
                         bias : 'T ^M;)
  returns (y: 'T ^M;)
  where 'T numeric
{
  diagram
    (/*
     ------------------
     Dense layer with: 
     * units=M
     * input_shape=(N,)
     * activation=None
     ------------------
     [ ∑i(wij*xi) + bj ]j
     */
     let
    #pragma diagram {"xy":"H-72620;V-46053","wh":"24000;19095"} #end)
    (#17 expr forward
      <<M>> with <<i>>
      diagram
        (#18 block (fold {text%(+)%text}) <<N>>
        #pragma diagram {"xy":"h41425;v-2247","wh":"24000;17975"} #end)
        (#20 def yi
        #pragma diagram {"xy":"h70925;v-2247"} #end)
        (#21 expr bias[i]
        #pragma diagram {"xy":"h20725;v-2778","wh":"12000;3200"} #end)
        (#1 expr kernel
        #pragma diagram {"xy":"h-70113;v6741","wh":"9626;3200"} #end)
        (#22 expr x
        #pragma diagram {"xy":"h-19925;v2247"} #end)
        (#23 block (map {text%(*)%text}) <<N>>
        #pragma diagram {"xy":"h-475;v2247","wh":"25000;17975"} #end)
        (#3 expr transpose {1,2} (#5)
          where
            (#5 group)
        #pragma diagram {"xy":"h-53200;v6741","wh":"20000;7000"} #end)
        (#6 expr #7[i]
          where
            (#7 group)
        #pragma diagram {"xy":"h-32875;v6741","wh":"12000;7000"} #end)
        
        (#26 wire #18 => #20
        #pragma diagram {"wp":"v-2000|#18 #20"} #end)
        (#27 wire #21 => #18 .(1))
        (#28 wire #23 => #18 .(2)
        #pragma diagram {"wp":"v-1506|#23 #18"} #end)
        (#8 wire #6 => #23 .(2))
        (#30 wire #22 => #23 .(1))
        (#9 wire #1 => #5)
        (#10 wire #3 => #7)
      returns ([yi])
    #pragma diagram {"xy":"H-71445;V-13636","wh":"158451;38869"} #end)
    (#2 def y
    #pragma diagram {"xy":"H22130;V-15683"} #end)
    
    (#4 wire #17 => #2
    #pragma diagram {"wp":"v-2047|#17 #2"} #end)
}

