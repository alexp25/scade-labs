    (#6 expr bias
    #pragma diagram {"xy":"H-56750;V-7707","wh":"10000;7000"} #end)
    (#8 block (map utils::conv <<C, H, W, Kh, Kw, Sh, Sw>> ) <<F>>
    #pragma diagram {"xy":"H-18550;V-3232","wh":"25000;18000"} #end)
    (#4 expr kernel
    #pragma diagram {"xy":"H-62950;V-899","wh":"9626;3200"} #end)
    (#5 expr #7 ^ (F)
      where
