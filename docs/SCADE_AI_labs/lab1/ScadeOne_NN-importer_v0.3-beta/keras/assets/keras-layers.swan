function TConv2D <<F, C, H, W, Kh, Kw, Sh, Sw>> (/* input */ x: 'T^C^W^H;
                                                 /* weights matrix */ kernel: 'T^Kw^Kh^C^F;
                                                 /* bias vector */ bias: 'T^F;)
  returns (y: 'T^F^((W - Kw + Sw) / Sw)^((H - Kh + Sh) / Sh);)
  where 'T numeric
{
  diagram
    (/*
     Conv2D layer with: 
     * padding='valid'
     * data_format="channels_last"
     * filters=F, 
     * input_shape=(H, W, C,)
     * kernel_size=(Kh, Kw)
     * strides=(Sh, Sw)
     * dilation_rate=(1, 1)
     * groups=1
     * activation=None
     
     -- TODO optim: instead of transposing the input and the output,
      the convolution computation could be reversed
     */ let
    #pragma diagram {"xy":"H18384;V12184","wh":"63069;28392"} #end)
    (#1 block (map utils::conv <<C, H, W, Kh, Kw, Sh, Sw>> ) <<F>>
    #pragma diagram {"xy":"H9900;V37775","wh":"25000;18000"} #end)
    (#3 expr bias
    #pragma diagram {"xy":"H-27000;V34263"} #end)
    (#4 expr x
    #pragma diagram {"xy":"H-105000;V43754"} #end)
    (#5 expr transpose {2, 3} (#6)
      where
        (#6 group)
    #pragma diagram {"xy":"H-81000;V43754","wh":"20000;7000"} #end)
    (#7 expr transpose {1, 2} (#8)
      where
        (#8 group)
    #pragma diagram {"xy":"H-51000;V43754","wh":"20000;7000"} #end)
    (#9 expr #10 ^ (F)
      where
        (#10 group)
    #pragma diagram {"xy":"H-26000;V43754","wh":"10000;7000"} #end)
    (#11 expr kernel
    #pragma diagram {"xy":"H-25813;V37763","wh":"9626;3200"} #end)
    (#12 expr transpose {2, 3} (#13)
      where
        (#13 group)
    #pragma diagram {"xy":"H75900;V37763","wh":"20000;7000"} #end)
    (#14 expr transpose {1, 2} (#15)
      where
        (#15 group)
    #pragma diagram {"xy":"H45900;V37763","wh":"20000;7000"} #end)
    (#16 def y
    #pragma diagram {"xy":"H99900;V37763"} #end)
    
    (#17 wire #3 => #1 .(bias))
    (#18 wire #4 => #6)
    (#19 wire #5 => #8)
    (#20 wire #7 => #10)
    (#21 wire #9 => #1 .(x))
    (#22 wire #11 => #1 .(weight))
    (#23 wire #1 => #15
    #pragma diagram {"wp":"v-2012|#1 #15"} #end)
    (#24 wire #14 => #13)
    (#25 wire #12 => #16)
}

