    #pragma diagram {"xy":"H-51450;V4201","wh":"10000;7000"} #end)
    
    (#12 wire #6 => #8 .(bias))
    (#14 wire #8 .(y) => #2
    #pragma diagram {"wp":"v-2013|#8 #2"} #end)
    (#9 wire #3 => #7)
    (#10 wire #5 => #8 .(x))
    (#11 wire #4 => #8 .(weight))
}

function PConv2D <<F, C, H, W, Kh, Kw, Sh, Sw, Ph, Pw>> (x: 'T^W^H^C;
                                                         kernel: 'T^Kw^Kh^C^F;
                                                         bias: 'T^F;)
  returns (y: 'T^((W - 1 + Sw) / Sw)^((H - 1 + Sh) / Sh)^F;)
  where 'T numeric
{
  diagram
    (/* PConv2D layer with: 
         * padding='same', 
         * data_format="channels_first", 
         * filters=F, 
         * input_shape=(C, H, W,), 
         * kernel_size=(Kh, Kw), 
         * strides=(Sh, Sw), 
         * dilation_rate=(1, 1), 
         * groups=1,
         * activation=None.
     -- TODO optim: instead of padding the input before convolution, 
         -the convolution could consider cells out range as 0
     */let
    #pragma diagram {"xy":"H-60160;V-39712","wh":"64006;24673"} #end)
    (#2 expr x
    #pragma diagram {"xy":"H-81743;V-15514"} #end)
    (#3 block (map utils::pad2d <<H, W, Ph, Pw>> ) <<C>>
    #pragma diagram {"xy":"H-48743;V-12114","wh":"25000;18000"} #end)
    (#5 expr (0 :> 'T)
    #pragma diagram {"xy":"H-90562;V-8426","wh":"12438;3200"} #end)
    (#8 def L1
    #pragma diagram {"xy":"H-18343;V-12126"} #end)
    (#9 expr L1
    #pragma diagram {"xy":"H-101362;V18102"} #end)
    (#10 block (map utils::conv <<C, H+Ph, W+Pw, Kh, Kw, Sh, Sw>> ) <<F>>
    #pragma diagram {"xy":"H-48743;V12123","wh":"25000;18000"} #end)
    (#12 def y
    #pragma diagram {"xy":"H-18343;V12110"} #end)
    (#13 expr bias
    #pragma diagram {"xy":"H-83643;V8610"} #end)
    (#11 expr #14 ^ (F)
      where
        (#14 group)
    #pragma diagram {"xy":"H-76550;V18102","wh":"10000;7000"} #end)
    (#15 expr kernel
    #pragma diagram {"xy":"H-87351;V12123","wh":"9626;3200"} #end)
    (#16 expr #22 ^ (C)
      where
        (#22 group)
    #pragma diagram {"xy":"H-76550;V-8426","wh":"10000;7000"} #end)
    
    (#18 wire #2 => #3 .(x))
    (#20 wire #3 .(y) => #8
    #pragma diagram {"wp":"v-2012|#3 #8"} #end)
    (#21 wire #13 => #10 .(bias))
    (#24 wire #10 .(y) => #12
    #pragma diagram {"wp":"v-2013|#10 #12"} #end)
    (#6 wire #5 => #22)
    (#7 wire #16 => #3 .(v))
    (#23 wire #15 => #10 .(weight))
    (#25 wire #11 => #10 .(x))
    (#27 wire #9 => #14)
    
    (var
        L1: 'T^(W + Pw)^(H + Ph)^C;)
}

function TPConv2D <<F, C, H, W, Kh, Kw, Sh, Sw, Ph, Pw>> (/* input */ x: 'T^C^W^H;
                                                          /* weights matrix */ kernel: 'T^Kw^Kh^C^F;
                                                          /* bias vector */ bias: 'T^F;)
  returns (y : 'T ^F ^(((W - 1) + Sw) / Sw) ^(((H - 1) + Sh) / Sh);)
  where 'T numeric
{
  diagram
    (/*
     Conv2D layer with: 
     * padding='same'
     * data_format="channels_last"
     * filters=F, 
     * input_shape=(H, W, C,)
     * kernel_size=(Kh, Kw)
     * strides=(Sh, Sw)
     * dilation_rate=(1, 1)
     * groups=1
     * activation=None
     
     -- TODO: optim padding and transpose
     */ let
    #pragma diagram {"xy":"H-5724;V4229","wh":"37754;26533"} #end)
    (#1 block (map utils::conv <<C, H + Ph, W + Pw, Kh, Kw, Sh, Sw>> ) <<F>>
    #pragma diagram {"xy":"H-33602;V34394","wh":"25000;18000"} #end)
    (#3 expr bias
    #pragma diagram {"xy":"H-68502;V28390"} #end)
    (#4 expr #5 ^ (F)
      where
        (#5 group)
    #pragma diagram {"xy":"H-69502;V40373","wh":"10000;7000"} #end)
    (#6 expr kernel
    #pragma diagram {"xy":"H-69315;V34381","wh":"9626;3200"} #end)
    (#7 expr transpose {2, 3} (#8)
      where
        (#8 group)
    #pragma diagram {"xy":"H32398;V28781","wh":"20000;7000"} #end)
    (#9 expr transpose {1, 2} (#10)
      where
        (#10 group)
    #pragma diagram {"xy":"H2398;V28781","wh":"20000;7000"} #end)
    (#11 def y
    #pragma diagram {"xy":"H56398;V28781"} #end)
    (#12 def _
    #pragma diagram {"xy":"H-96735;V69775"} #end)
    (#13 def L2
    #pragma diagram {"xy":"H8398;V34381"} #end)
    (#14 expr L2
    #pragma diagram {"xy":"H-114448;V76250"} #end)
    (#15 expr L1
    #pragma diagram {"xy":"H-114448;V69775"} #end)
    (#16 expr x
    #pragma diagram {"xy":"H-191302;V50467"} #end)
    (#17 block (map utils::pad2d <<H, W, Ph, Pw>> ) <<C>>
    #pragma diagram {"xy":"H-100902;V45986","wh":"25000;18000"} #end)
    (#19 expr transpose {1, 2} (#20)
      where
        (#20 group)
    #pragma diagram {"xy":"H-137302;V50467","wh":"20000;7000"} #end)
    (#21 expr transpose {2, 3} (#22)
      where
        (#22 group)
    #pragma diagram {"xy":"H-167302;V50467","wh":"20000;7000"} #end)
    (#23 expr (0 :> 'T) ^C
    #pragma diagram {"xy":"H-134928;V41479","wh":"15251;3200"} #end)
    (#24 def L1
    #pragma diagram {"xy":"H-68502;V45973"} #end)
    (#25 def _
    #pragma diagram {"xy":"H-96448;V76250"} #end)
    (/* Note: L1 and L2 are kept for comparing with previous SCADE 6 Implementation */let
    #pragma diagram {"xy":"H-93859;V64700","wh":"82758;3200"} #end)
    
    (#26 wire #3 => #1 .(bias)
    #pragma diagram {"wp":"#3 h10700 v2673 #1"} #end)
    (#27 wire #4 => #1 .(x))
    (#28 wire #6 => #1 .(weight))
    (#29 wire #1 => #10, #13
    #pragma diagram {"wp":"v-2013|#1 h6750[v-5600 #10, #13]"} #end)
    (#30 wire #9 => #8)
    (#31 wire #7 => #11)
    (#32 wire #14 => #25)
    (#33 wire #15 => #12)
    (#34 wire #21 => #20)
    (#35 wire #16 => #22)
    (#36 wire #19 => #17 .(x))
    (#37 wire #23 => #17 .(v))
    (#38 wire #17 .(y) => #24, #5
    #pragma diagram {"wp":"v-3725|#17 h4475[h4950 v1712 #24, v-3888 #5]"} #end)
    
    (var
        L1 : 'T ^(W + (Kw - 1)) ^(H + (Kh - 1)) ^C;
        L2 : 'T ^((((W + (Kw - 1)) - Kw) + Sw) / Sw) ^((((H + (Kh - 1)) - Kh) + Sh) / Sh) ^F;)
}

{text%
      /* LSTM layer with: units=U, input_shape=(TS,F), return_state=False, go_backwards=False, return_state=True, return_sequences=False, initial_state=[h_0, c_0], mask=None, activation='tanh' and recurrent_activation='sigmoid' */
      function LSTM<<TS, F, U>> (
            inputs: 'T^F^TS;
            h_0: 'T^U;
            c_0: 'T^U;
            kernel: 'T^(4 * U)^F;
            recurrent_kernel: 'T^(4 * U)^U;
            bias: 'T^(4 * U))
          returns (h: 'T^U) where 'T float {
          let
            h, _, _ = (
                function (
                  h_1: 'T^U;
                  j_1: 'T^U;
                  k: 'T^F^TS;
                  l: 'T^(4 * U)^F^TS;
                  m: 'T^(4 * U)^U^TS;
                  n: 'T^(4 * U)^TS)
                returns (
                  p: 'T^U;
                  q: 'T^U;
                  r: 'T^U^TS){
                  var
                    opcall: ((l1 : 'T^U, l2 : 'T^U), 'T^U^TS);
                  let
                    opcall = (
                        mapfold (
                          function (
                            a: (l1 : 'T^U, l2 : 'T^U);
                            b_1: 'T^F;
                            c_1: 'T^(4 * U)^F;
                            d: 'T^(4 * U)^U;
                            e: 'T^(4 * U))
                          returns (
                            f: (l1 : 'T^U, l2 : 'T^U);
                            g: 'T^U){
                            var
                              v_1: 'T^U;
                              v_1_1: 'T^U;
                            let
                              v_1, v_1_1, g = utils::LSTMCell <<F, U>> (a.(l1, l2), b_1, c_1, d, e);
                              f = (l1: v_1, l2: v_1_1);
                          }
        
                        )
                      ) <<TS>> ((l1: h_1, l2: j_1), k, l, m, n);
                    p, q = opcall.(1).(l1, l2);
                    r = opcall.(2);
                }
        
              ) (h_0, c_0, inputs, kernel^TS, recurrent_kernel^TS, bias^TS);
        }
            %text}

{text% function BatchNorm3D<<C, H, W>> (
          x: 'T^C^W^H;
          scale: 'T^C;
          offset: 'T^C;
          mean: 'T^C;
          variance: 'T^C;
          epsilon: 'T)
        returns (y: 'T^C^W^H) where 'T float {
        let
          L = (map (+)) <<C>> $N1 (variance, epsilon^C);
          y = (map (map (map utils::normalize) <<C>>) <<W>>) <<H>> $N2 (
              x, scale^W^H, offset^W^H, mean^W^H, L^W^H
            );
        var
          L: 'T^C;
      }
       %text}

{text% function TZeroPadding2D<<C, H, W, Pht, Phb, Pwl, Pwr>> (x: 'T^C^W^H)
        returns (y: 'T^C^(W + Pwl + Pwr)^(H + Pht + Phb)) where 'T numeric {
        let
          _, y = (
              mapi (mapfoldi utils::pad_cell_0v <<C, H, W, Pht, Pwl>>) <<W + Pwl
              + Pwr>>
            ) <<H + Pht + Phb>> $N1 (x^(W + Pwl + Pwr)^(H + Pht + Phb));
      }
       %text}

{text% function ZeroPadding2D<<C, H, W, Pht, Phb, Pwl, Pwr>> (x: 'T^W^H^C)
        returns (y: 'T^(W + Pwl + Pwr)^(H + Pht + Phb)^C) where 'T numeric {
        let
          y = (map utils::pad2d_v2 <<H, W, Pht, Phb, Pwl, Pwr>>) <<C>> $N1 (x, 0^C);
      }
       %text}
