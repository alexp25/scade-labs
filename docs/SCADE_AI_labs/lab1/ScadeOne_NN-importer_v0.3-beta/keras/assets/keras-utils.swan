inline function max_index <<N>> (x: 'T^N;)
  returns (idx: int32;
           value : 'T;)
  where 'T numeric
{
  diagram
    (#0 def max_val
    #pragma diagram {"xy":"H-18650;V-22300","wh":"10563;3200"} #end)
    (#1 block max_vector <<N>> 
    #pragma diagram {"xy":"H-47832;V-22300","wh":"20000;14000"} #end)
    (#2 expr x
    #pragma diagram {"xy":"H-75732;V-22300"} #end)
    (#3 expr forward
      <<N>> with <<i>>
      diagram
        (#4 def max_idx
        #pragma diagram {"xy":"h9000;v0","wh":"10563;3200"} #end)
        (#5 expr i
        #pragma diagram {"xy":"h-10281;v0"} #end)
        
        (#6 wire #5 => #4)
      until x[i] = max_val
      returns (max_idx)
    #pragma diagram {"xy":"H13317;V-22300","wh":"37163;20000"} #end)
    (#7 def idx
    #pragma diagram {"xy":"H49799;V-22300"} #end)
    (#12 def value
    #pragma diagram {"xy":"H49799;V-4250","wh":"8688;3200"} #end)
    (#13 expr max_val
    #pragma diagram {"xy":"H22117;V-4250","wh":"10563;3200"} #end)
    
    (#8 wire #1 .(y) => #0
    #pragma diagram {"wp":"v0|#1 #0"} #end)
    (#9 wire #2 => #1 .(x))
    (#10 wire #3 .(1) => #7
    #pragma diagram {"wp":"v0|#3 #7"} #end)
    (#14 wire #13 => #12)
    
    (var
        max_val: 'T;)
}

