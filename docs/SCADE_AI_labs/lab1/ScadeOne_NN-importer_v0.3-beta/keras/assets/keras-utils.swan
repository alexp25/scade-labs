{text%
      /* extraction of the [h,w] cell of kernel KhxKw from matrix HxW at position [i, j] */
         inline function kernel_cell_extraction<<H, W>> (
                w: uint32;
                h: uint32;
                i: uint32;
                j: uint32;
                x: 'T^W^H)
              returns (y: 'T) where 'T numeric {
              let
                y = (x . [i + h][j + w] default 0);
            }
      %text}

{text%inline function conv<<C, H, W, Kh, Kw, Sh, Sw>> (
          bias: 'T;
          x: 'T^W^H^C;
          weight: 'T^Kw^Kh^C)
        returns (y: 'T^((W - Kw + Sw) / Sw)^((H - Kh + Sh) / Sh)) where 'T numeric {
        let
          y = (mapi conv_row <<C, H, W, Kh, Kw, Sh, Sw>>) <<(H - Kh + Sh) /
            Sh>> (
              bias^((H - Kh + Sh) / Sh), x^((H - Kh + Sh) / Sh), weight^(
                (H - Kh + Sh) / Sh
              )
            );
      }
      %text}

{text%inline function conv_kernel<<C, H, W, Kh, Kw, Sh, Sw>> (
          j: uint32;
          i: uint32;
          bias: 'T;
          x: 'T^W^H^C;
          weight: 'T^Kw^Kh^C)
        returns (y: 'T) where 'T numeric {
        var
          L1: 'T^Kw^Kh^C;
        let
          L1 = (map kernel_extraction <<H, W, Kh, Kw>>) <<C>> (
              x, (i * Sh)^C, (j * Sw)^C
            );
          y = cross_correlation_bias <<C, Kh, Kw>> (bias, L1, weight);
      }
      %text}

{text%inline function conv_row<<C, H, W, Kh, Kw, Sh, Sw>> (
          i: uint32;
          bias: 'T;
          x: 'T^W^H^C;
          weight: 'T^Kw^Kh^C)
        returns (y: 'T^((W - Kw + Sw) / Sw)) where 'T numeric {
        let
          y = (mapi conv_kernel <<C, H, W, Kh, Kw, Sh, Sw>>) <<(W - Kw + Sw) /
            Sw>> (
              i^((W - Kw + Sw) / Sw), bias^((W - Kw + Sw) / Sw), x^(
                (W - Kw + Sw) / Sw
              ), weight^((W - Kw + Sw) / Sw)
            );
      }
      %text}

inline function cross_correlation_bias <<C, H, W>> (bias: 'T;
                                                    x: 'T^W^H^C;
                                                    weight: 'T^W^H^C;)
  returns (y: 'T;)
  where 'T numeric
{
  diagram
    (/* cross correlation product of matrices x and weight plus bias */ let
    #pragma diagram {"xy":"H-29272;V-3450","wh":"69632;3200"} #end)
    (#1 block (fold 
                (fold dot_bias <<W>> ) <<H>>)
               <<C>>
    #pragma diagram {"xy":"H-22550;V15025","wh":"25000;21000"} #end)
    (#3 expr bias
    #pragma diagram {"xy":"H-58450;V10025"} #end)
    (#4 expr x
    #pragma diagram {"xy":"H-58450;V17350"} #end)
    (#5 expr weight
    #pragma diagram {"xy":"H-57637;V23925","wh":"9626;3200"} #end)
    (#6 def y
    #pragma diagram {"xy":"H6344;V15025"} #end)
    
    (#7 wire #4 => #1 .(x))
    (#8 wire #3 => #1 .(b)
    #pragma diagram {"wp":"#3 h11200 v2537 #1"} #end)
    (#9 wire #5 => #1 .(w))
    (#10 wire #1 => #6
    #pragma diagram {"wp":"v-3500|#1 #6"} #end)
}

inline function max_pool <<H, W, Kh, Kw, Sh, Sw>> (x: 'T^W^H;)
  returns (y: 'T^((W - Kw + Sw) / Sw)^((H - Kh + Sh) / Sh);)
  where 'T numeric
{
  diagram
    (#0 block (mapi max_pool_row <<H, W, Kh, Kw, Sh, Sw>> ) <<(H - Kh + Sh) / Sh>>
    #pragma diagram {"xy":"H-10374;V-23950","wh":"47553;18000"} #end)
    (#2 expr x^((H - Kh + Sh) / Sh)
    #pragma diagram {"xy":"H-65012;V-21950","wh":"24627;3200"} #end)
    (#3 def y
    #pragma diagram {"xy":"H26650;V-21950"} #end)
    
    (#4 wire #2 => #0 .(x))
    (#5 wire #0 => #3
    #pragma diagram {"wp":"v0|#0 #3"} #end)
}

{text%
      inline function pad2d<<H, W, Ph, Pw>> (x: 'T^W^H; v: 'T)
              returns (y: 'T^(W + Pw)^(H + Ph)) where 'T numeric {
              let
                y = (mapi pad_row <<H, W, Pw>>) <<H + Ph>> (
                    math::half (Ph)^(H + Ph), math::half (Pw)^(H + Ph), x^(H + Ph),
                    v^(H + Ph)
                  );
            }
            %text}

{text%inline function pad_cell<<H, W>> (
          j: uint32;
          i: uint32;
          Pwl: uint32;
          Pht: uint32;
          x: 'T^W^H;
          v: 'T)
        returns (y: 'T) where 'T numeric {
        let
          y = (x . [i - Pht][j - Pwl] default v);
      }
      %text}

{text%inline function pad_row<<H, W, Pw>> (
          i: uint32;
          Pht: uint32;
          Pwl: uint32;
          x: 'T^W^H;
          v: 'T)
        returns (y: 'T^(W + Pw)) where 'T numeric {
        let
          y = (mapi pad_cell <<H, W>>) <<W + Pw>> (
              i^(W + Pw), Pwl^(W + Pw), Pht^(W + Pw), x^(W + Pw), v^(W + Pw)
            );
      }
      %text}

{text%
      inline function LSTMCell<<F, U>> (
          h_tm1: 'T^U;
          c_tm1: 'T^U;
          inputs: 'T^F;
          kernel: 'T^(4 * U)^F;
          recurrent_kernel: 'T^(4 * U)^U;
          bias: 'T^(4 * U))
        returns (h: 'T^U; c: 'T^U; h2: 'T^U) where 'T float {
        var
          z0: 'T^U;
          z1: 'T^U;
          z2: 'T^U;
          z3: 'T^U;
        let
          z0, z1, z2, z3 = lstm_cell_dot <<F, U>> (
              h_tm1, inputs, kernel, recurrent_kernel, bias
            );
          c, h = (map lstm_cell_c_h) <<U>> (c_tm1, z0, z1, z2, z3);
          h2 = h;
      }
      %text}

{text%
      inline function lstm_cell_c_h(c_tm1: 'T; z0: 'T; z1: 'T; z2: 'T; z3: 'T)
        returns (c: 'T; h: 'T) where 'T float {
        var
          L1: 'T;
        let
          L1 = c_tm1 * activations::sigmoid (z1) + activations::sigmoid (z0) *
            activations::tanh (z2);
          c = L1;
          h = activations::tanh (L1) * activations::sigmoid (z3);
      }
      %text}

{text%
      inline function lstm_cell_dot<<F, U>> (
          h_tm1: 'T^U;
          inputs: 'T^F;
          kernel: 'T^(4 * U)^F;
          recurrent_kernel: 'T^(4 * U)^U;
          bias: 'T^(4 * U))
        returns (z0: 'T^U; z1: 'T^U; z2: 'T^U; z3: 'T^U) where 'T float {
        var
          L1: 'T^(4 * U);
          L2: 'T^(4 * U);
          L3: 'T^(4 * U);
        let
          L1 = (map dot_bias <<F>>) <<4 * U>>  (
              0^(4 * U), inputs^(4 * U), transpose { 1, 2 }(kernel)
            );
          L2 = (map dot_bias <<U>>) <<4 * U>> (
              bias, h_tm1^(4 * U), transpose { 1, 2 } (recurrent_kernel)
            );
          L3 = (map (+)) <<4 * U>> (L1, L2);
          z0 = L3[0 .. U - 1];
          z1 = L3[U .. 2 * U - 1];
          z2 = L3[2 * U .. 3 * U - 1];
          z3 = L3[3 * U .. 4 * U - 1];
      }
      %text}

inline function row_extract_2d <<N, M>> (i: uint64;
                                         x: 'T^M^N;)
  returns (y: 'T^M;)
  where 'T numeric
{
  diagram
    (#0 expr (x . [i] default x[0])
    #pragma diagram {"xy":"H-3012;V-28450","wh":"24627;3200"} #end)
    (#1 def y
    #pragma diagram {"xy":"H16750;V-28450"} #end)
    
    (#2 wire #0 => #1)
}

{text% inline function normalize(
          x: 'T;
          scale: 'T;
          offset: 'T;
          mean: 'T;
          variance: 'T)
        returns (y: 'T) where 'T float {
        let
          y = (x - mean) / math::sqrt $N1 (variance) * scale + offset;
      }
       %text}

{text% inline function pad2d_v2<<H, W, Pht, Phb, Pwl, Pwr>> (x: 'T^W^H; v: 'T)
        returns (y: 'T^(W + Pwl + Pwr)^(H + Pht + Phb)) where 'T numeric {
        let
          y = (mapi pad_row <<H, W, Pwl + Pwr>>) <<H + Pht + Phb>> $N1 (
              Pht^(H + Pht + Phb), Pwl^(H + Pht + Phb), x^(H + Pht + Phb), v^(
                H + Pht + Phb
              )
            );
      }
       %text}

{text% inline function pad_cell_0v<<C, H, W, Pht, Pwl>> (
          j: uint32;
          i: uint32;
          x: 'T^C^W^H)
        returns (ni: uint32; y: 'T^C) where 'T numeric {
        let
          y = (x . [i - Pht][j - Pwl] default 0^C);
          ni = i;
      }
       %text}
