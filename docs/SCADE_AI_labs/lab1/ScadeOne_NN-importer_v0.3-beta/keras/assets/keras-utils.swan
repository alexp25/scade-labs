  where 'T numeric
{
  diagram
    (#0 block (fold {text%(+)%text}) <<N>>
    #pragma diagram {"xy":"H8550;V-6162","wh":"25000;18000"} #end)
    (#2 block (map {text%(*)%text}) <<N>>
    #pragma diagram {"xy":"H-33850;V-1669","wh":"25000;18000"} #end)
    (#4 expr x
    #pragma diagram {"xy":"H-64250;V2812"} #end)
    (#5 expr w
    #pragma diagram {"xy":"H-64250;V-6175"} #end)
    (#6 expr b
    #pragma diagram {"xy":"H-12650;V-6175"} #end)
    (#7 def y
    #pragma diagram {"xy":"H38550;V-6175"} #end)
    (/* dot product of vectors x and w plus bias b */ let
    #pragma diagram {"xy":"H-13911;V-23275","wh":"52755;3200"} #end)
    
    (#9 wire #4 => #2 .(1))
    (#10 wire #5 => #2 .(2))
    (#11 wire #2 => #0 .(2)
    #pragma diagram {"wp":"v-1000|#2 #0"} #end)
    (#12 wire #0 => #7
    #pragma diagram {"wp":"v-2013|#0 #7"} #end)
    (#13 wire #6 => #0 .(1))
}

